# Copy to .env. Never commit .env; .gitignore already excludes it.
# 8000 matches the phone line and is the default. 16000 only for studio-mic work; a keyterm
# result measured at 16 kHz does not transfer to a call.
AUDIO_SAMPLE_RATE=8000

PORT=3000
HOST=127.0.0.1
PUBLIC_URL=                  # ngrok or similar, Vonage webhooks must reach it

VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=
VONAGE_NUMBER=

DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=flux-general-en
DEEPGRAM_TTS_VOICE=flux-haley-en

LLM_PROVIDER=anthropic
LLM_API_KEY=                 # or set ANTHROPIC_API_KEY
LLM_MODEL=claude-opus-5

# Beat 2. The keyterms the toggle pushes onto the live socket. The surname is the gate; the other
# two are the business and the dog. See docs/SCRIPT.md before changing.
# DEMO_KEYTERMS=Gutentag,Bramble Hill,Brisket

# --local mode only
LOCAL_MIC_DEVICE=none:default
LOCAL_SPEAKER_DEVICE=-1              # audiotoolbox output index, -1 = system default
LOCAL_MUTE_WHILE_SPEAKING=0
